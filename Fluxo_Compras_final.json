        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"llama-3.3-70b-versatile\",\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"Voce e um classificador de materiais. Analise o pedido e retorne APENAS um JSON valido, sem texto adicional, sem markdown, sem explicacoes.\\n\\nMateriais e categorias disponiveis:\\n- Fio → Estrutura\\n- Disco → Ferramenta\\n- Areia → Agregados\\n\\nSe o pedido mencionar um desses materiais, retorne:\\n{\\\"material\\\": \\\"nome exato conforme lista\\\", \\\"categoria\\\": \\\"categoria exata conforme lista\\\", \\\"quantidade\\\": null}\\n\\nSe nao identificar nenhum material da lista, retorne:\\n{\\\"material\\\": null, \\\"categoria\\\": null, \\\"quantidade\\\": null}\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"{{ $json.body.text.message }}\"\n    }\n  ]\n}",
        "options": {}
      },
