    {
      "parameters": {
        "jsCode": "const groq1Output = $('Groq1').first().json;\nconst materialRaw = groq1Output.choices[0].message.content;\n\nlet parsed;\ntry {\n  parsed = JSON.parse(materialRaw);\n} catch(e) {\n  parsed = null;\n}\n\nconst materiaisValidos = ['Fio', 'Disco', 'Areia'];\nconst materialValido = parsed && parsed.material && materiaisValidos.includes(parsed.material);\n\nif (!materialValido) {\n  return [{ json: { mensagemErro: 'Nao identifiquei um material de compras no seu pedido. Descreva o que precisa comprar. Ex: Areia, Disco, Fio.' } }];\n}\n\nconst materialPedido = parsed.material.trim();\nconst categoriaped = parsed.categoria.trim();\nconst todosFornecedores = $input.all();\n\nconst fornecedoresFiltrados = todosFornecedores.filter(item => {\n  const f = item.json;\n  const catPlanilha = (f['Categoria '] || f['Categoria'] || '').trim();\n  const matPlanilha = (f['Material'] || f['Material '] || '').trim();\n  const homologado = (f['Homologado '] || f['Homologado'] || '').trim().toLowerCase();\n  return catPlanilha === categoriaped && matPlanilha === materialPedido && homologado === 'sim';\n});\n\nif (fornecedoresFiltrados.length === 0) {\n  return [{ json: { mensagemErro: 'Material nao encontrado na base de fornecedores. Verifique o nome ou consulte o responsavel pelo cadastro.' } }];\n}\n\nconst materialInfo = 'Material: ' + parsed.material + ' | Categoria: ' + parsed.categoria;\n\nconst fornecedores = fornecedoresFiltrados.map(item => {\n  const f = item.json;\n  const nome = (f['Fornecedor '] || f['Fornecedor'] || 'N/A').trim();\n  const preco = f['Preço_ref'] || f['Preco_ref'] || 'N/A';\n  const prazo = f['Prazo_dias'] || 'N/A';\n  const disp = (f['Disponibilidade '] || f['Disponibilidade'] || 'N/A').trim();\n  return nome + ' | R$ ' + preco + ' | Prazo: ' + prazo + ' dias | Disponibilidade: ' + disp;\n}).join('\\n');\n\nconst userContent = materialInfo + '\\n\\nFornecedores encontrados:\\n' + fornecedores;\n\nconst payload = {\n  model: 'llama-3.3-70b-versatile',\n  messages: [\n    {\n      role: 'system',\n      content: 'Voce e um agente de compras. Monte um briefing estruturado.\\n\\nFormato obrigatorio:\\n\\nBRIEFING DE COMPRAS\\nMaterial: [material]\\nCategoria: [categoria]\\n\\nFORNECEDORES DISPONIVEIS\\n- [Nome] | R$ [preco] | Prazo: [X] dias | Disponibilidade: [nivel]\\n\\nRECOMENDACAO\\n[Melhor opcao justificada]'\n    },\n    {\n      role: 'user',\n      content: userContent\n    }\n  ]\n};\n\nreturn [{ json: { payload } }];"
      },
